# Copie para .env e preencha.

# SQLite (caminho relativo ao prisma/schema.prisma)
DATABASE_URL="file:../data/app.db"

# URL pública do site (usada nos redirects do OAuth e nos links/QR de torneio)
SITE_URL=http://localhost:3000

# Google OAuth — MESMA aplicação do GLC Hub (copie do .env da VPS do glchub).
# Lembre de cadastrar o redirect novo no Google Console:
#   {SITE_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails que viram admin automaticamente ao logar (separados por vírgula)
ADMIN_EMAILS=tharcisio.neles@gmail.com

# Porta do servidor
PORT=3000

# Login de desenvolvimento (POST /api/auth/dev-login) — NUNCA ligar em produção
DEV_LOGIN=0

TZ=America/Sao_Paulo
