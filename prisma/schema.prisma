// BX Deck Lab — schema (SQLite não suporta enums; campos de "tipo" usam
// strings com valores documentados em cada campo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contas
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  slug           String    @unique
  avatarUrl      String?
  bannerUrl      String?
  bio            String?
  whatsapp       String? // só dígitos com DDI, ex.: 5511999998888
  role           String    @default("USER") // USER | ORGANIZER | MOD | ADMIN
  verified       Boolean   @default(false)
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  statusReason   String?
  suspendedUntil DateTime?
  canSell        Boolean   @default(true)
  favoritePartId String?
  frameId        String? // Cosmetic (FRAME) equipado
  stickersJson   String    @default("[]") // ids de Cosmetic (STICKER) exibidos no perfil
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  sessions       AuthSession[]
  decks          CommunityDeck[]
  collection     CollectionItem[]
  combos         Combo[]
  tournaments    Tournament[]      @relation("organizer")
  entries        TournamentPlayer[]
  cosmetics      CosmeticGrant[]
  favoritePart   Part?             @relation(fields: [favoritePartId], references: [id], onDelete: SetNull)
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catálogo: peças e produtos
// ---------------------------------------------------------------------------

model Part {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String // BLADE | LOCK_CHIP | OVER_BLADE | MAIN_BLADE | ASSIST_BLADE | RATCHET | BIT
  subKind     String? // INTEGRATED (blade com ratchet integrada) | RIB (bit com ratchet integrada)
  name        String // nome canônico (Takara Tomy), ex.: DranSword
  displayName String // nome exibido, ex.: Sword Dran
  aliasesJson String   @default("[]")
  abbrev      String? // ex.: LF, 3-60
  type        String? // Attack | Defense | Stamina | Balance (quando confiável)
  statsJson   String? // {atk,def,sta,dash?}
  note        String?
  behavior    String?
  imageUrl    String?
  banned      Boolean  @default(false)
  hidden      Boolean  @default(false)
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductPart[]
  favoriteOf  User[]

  @@index([kind])
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  code        String? // BX-01, UX-05, CX-02, F0349...
  line        String? // BX | UX | CX | HASBRO | OTHER
  name        String
  brand       String    @default("TAKARA_TOMY") // TAKARA_TOMY | HASBRO | OTHER
  category    String? // STARTER | BOOSTER | RANDOM_BOOSTER | SET | ACCESSORY
  beyType     String? // Attack | Defense | Stamina | Balance (produto de Bey única)
  imageUrl    String?
  releaseDate DateTime?
  hidden      Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parts       ProductPart[]

  @@index([line, code])
}

model ProductPart {
  id        String  @id @default(cuid())
  productId String
  partId    String
  qty       Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([productId, partId])
}

// ---------------------------------------------------------------------------
// Comunidade: deck lists
// ---------------------------------------------------------------------------

model CommunityDeck {
  id            String   @id @default(cuid())
  slug          String   @unique
  authorId      String
  title         String
  description   String?
  launchGuide   String?
  youtubeUrl    String?
  beysJson      String // [[partId,...] x3]
  status        String   @default("VISIBLE") // VISIBLE | HIDDEN
  featuredOrder Int? // não-nulo = fixado na home pelo admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Coleção e marketplace
// ---------------------------------------------------------------------------

model CollectionItem {
  id         String  @id @default(cuid())
  userId     String
  partId     String
  qty        Int     @default(1)
  forSale    Boolean @default(false)
  condition  String? // ex.: "Nova", "Usada — ótima", "Usada — com desgaste"
  priceCents Int?
  hidden     Boolean @default(false) // moderação: anúncio ocultado pelo admin
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
}

model Combo {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  partsJson   String // [partId, ...]
  forSale     Boolean  @default(false)
  condition   String?
  priceCents  Int?
  status      String   @default("VISIBLE") // VISIBLE | HIDDEN
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Torneios
// ---------------------------------------------------------------------------

model Tournament {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  storeName     String?
  address       String?
  startsAt      DateTime
  format        String   @default("MD3") // MD3 | POINTS4
  roundsPlanned Int      @default(4)
  description   String?
  status        String   @default("OPEN") // OPEN | RUNNING | FINISHED | CANCELED
  currentRound  Int      @default(0)
  organizerId   String
  createdAt     DateTime @default(now())
  organizer     User     @relation("organizer", fields: [organizerId], references: [id], onDelete: Cascade)

  players       TournamentPlayer[]
  matches       TMatch[]
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  joinedAt     DateTime @default(now())
  dropped      Boolean  @default(false)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  asP1         TMatch[]   @relation("p1")
  asP2         TMatch[]   @relation("p2")

  @@unique([tournamentId, userId])
}

model TMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  tableNo      Int
  p1Id         String
  p2Id         String? // null = BYE (p1 vence automaticamente)
  p1Report     String? // WIN | LOSS
  p2Report     String? // WIN | LOSS
  winnerId     String? // TournamentPlayer.id
  status       String    @default("PENDING") // PENDING | CONFLICT | DONE
  resolvedBy   String? // AUTO | ORGANIZER
  updatedAt    DateTime  @updatedAt
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  p1           TournamentPlayer  @relation("p1", fields: [p1Id], references: [id], onDelete: Cascade)
  p2           TournamentPlayer? @relation("p2", fields: [p2Id], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
}

// ---------------------------------------------------------------------------
// Moderação, cosméticos e operação
// ---------------------------------------------------------------------------

model Report {
  id          String    @id @default(cuid())
  reporterId  String?
  targetType  String // DECK | USER | LISTING | COMBO | TOURNAMENT
  targetId    String
  reason      String
  status      String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolution  String?
  handledById String?
  createdAt   DateTime  @default(now())
  handledAt   DateTime?

  @@index([status])
}

model Cosmetic {
  id        String   @id @default(cuid())
  kind      String // FRAME | STICKER
  name      String
  imageUrl  String? // FRAMEs podem ser CSS puro (styleKey) em vez de imagem
  styleKey  String? // chave de moldura pré-definida em CSS (ex.: "xtreme", "ember")
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) // true = disponível para todos
  createdAt DateTime @default(now())

  grants    CosmeticGrant[]
}

model CosmeticGrant {
  id          String   @id @default(cuid())
  userId      String
  cosmeticId  String
  grantedById String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Setting {
  key   String @id
  value String // JSON
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String
  ok        Boolean
  message   String?
  createdAt DateTime @default(now())
}
