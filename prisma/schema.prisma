// BX Deck Lab — schema (SQLite não suporta enums; campos de "tipo" usam
// strings com valores documentados em cada campo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contas
// ---------------------------------------------------------------------------

model User {
  physicalDecks PhysicalDeck[]
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  slug           String    @unique
  passwordHash   String? // null = conta só-Google
  avatarUrl      String?
  bannerUrl      String?
  bio            String?
  whatsapp       String? // só dígitos com DDI, ex.: 5511999998888
  role           String    @default("USER") // USER | ORGANIZER | MOD | ADMIN
  verified       Boolean   @default(false)
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  statusReason   String?
  suspendedUntil DateTime?
  canSell        Boolean   @default(true)
  favoritePartId String?
  frameId        String? // Cosmetic (FRAME) equipado
  stickersJson   String    @default("[]") // ids de Cosmetic (STICKER) exibidos no perfil
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  sessions       AuthSession[]
  decks          CommunityDeck[]
  collection     CollectionItem[]
  combos         Combo[]
  tournaments    Tournament[]      @relation("organizer")
  entries        TournamentPlayer[]
  cosmetics      CosmeticGrant[]
  favoritePart   Part?             @relation(fields: [favoritePartId], references: [id], onDelete: SetNull)
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  pollVotes      PollVote[]
  notifications  Notification[]    @relation("notifTarget")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catálogo: peças e produtos
// ---------------------------------------------------------------------------

model Part {
  id          String   @id @default(cuid())
  slug        String   @unique
  kind        String // BLADE | LOCK_CHIP | OVER_BLADE | MAIN_BLADE | ASSIST_BLADE | RATCHET | BIT
  subKind     String? // INTEGRATED (blade com ratchet integrada) | RIB (bit com ratchet integrada)
  name        String // nome canônico (Takara Tomy), ex.: DranSword
  displayName String // nome exibido, ex.: Sword Dran
  aliasesJson String   @default("[]")
  abbrev      String? // ex.: LF, 3-60
  type        String? // Attack | Defense | Stamina | Balance (quando confiável)
  statsJson   String? // {atk,def,sta,dash?}
  note        String?
  behavior    String?
  imageUrl    String?
  imagesJson  String   @default("[]") // variantes de cor (galeria)
  weightGrams Float?
  bcSlug      String? // slug na BeyCommunity (casa relações no sync)
  banned      Boolean  @default(false)
  hidden      Boolean  @default(false)
  source      String?
  // Recolors: cada cor é uma peça-filha (id próprio) agrupada pela peça-pai
  parentId     String?
  variantLabel String? // ex.: "Cor 2", "Ver. Vermelha"
  variantOrder Int      @default(0)
  parent       Part?    @relation("PartVariants", fields: [parentId], references: [id], onDelete: Cascade)
  variants     Part[]   @relation("PartVariants")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductPart[]
  favoriteOf  User[]

  @@index([kind])
  @@index([parentId])
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  code        String? // BX-01, UX-05, CX-02, F0349...
  line        String? // BX | UX | CX | HASBRO | OTHER
  name        String
  brand       String    @default("TAKARA_TOMY") // TAKARA_TOMY | HASBRO | OTHER
  category    String? // STARTER | BOOSTER | RANDOM_BOOSTER | SET | ACCESSORY
  beyType     String? // Attack | Defense | Stamina | Balance (produto de Bey única)
  imageUrl    String?
  releaseDate DateTime?
  bcSlug      String? // slug na BeyCommunity
  hidden      Boolean   @default(false)
  notes       String?
  combosSyncedAt DateTime? // quando as cores das peças (combos da BeyCommunity) foram lidas
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parts       ProductPart[]

  @@index([line, code])
}

model ProductPart {
  id        String  @id @default(cuid())
  productId String
  partId    String
  qty       Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([productId, partId])
}

// ---------------------------------------------------------------------------
// Comunidade: deck lists
// ---------------------------------------------------------------------------

model CommunityDeck {
  id            String   @id @default(cuid())
  slug          String   @unique
  authorId      String
  title         String
  description   String?
  launchGuide   String?
  youtubeUrl    String?
  beysJson      String // [[partId,...] x3]
  status        String   @default("VISIBLE") // VISIBLE | HIDDEN (moderação)
  isPublic      Boolean  @default(true) // false = só o autor vê
  folder        String? // pasta do arquivo pessoal do autor
  featuredOrder Int? // não-nulo = fixado na home pelo admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Coleção e marketplace
// ---------------------------------------------------------------------------

model CollectionItem {
  id         String  @id @default(cuid())
  userId     String
  partId     String
  qty        Int     @default(1)
  forSale    Boolean @default(false)
  condition  String? // ex.: "Nova", "Usada — ótima", "Usada — com desgaste"
  priceCents Int?
  hidden     Boolean @default(false) // moderação: anúncio ocultado pelo admin
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
}

model Combo {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  partsJson   String // [partId, ...]
  forSale     Boolean  @default(false)
  condition   String?
  priceCents  Int?
  status      String   @default("VISIBLE") // VISIBLE | HIDDEN
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Torneios
// ---------------------------------------------------------------------------

model Tournament {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  storeName     String?
  address       String?
  startsAt      DateTime
  format        String   @default("MD3") // MD3 | POINTS4
  roundsPlanned Int      @default(4)
  description   String?
  status        String   @default("OPEN") // OPEN | RUNNING | FINISHED | CANCELED
  currentRound  Int      @default(0)
  organizerId   String
  createdAt     DateTime @default(now())
  organizer     User     @relation("organizer", fields: [organizerId], references: [id], onDelete: Cascade)

  players       TournamentPlayer[]
  matches       TMatch[]
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  joinedAt     DateTime @default(now())
  dropped      Boolean  @default(false)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  asP1         TMatch[]   @relation("p1")
  asP2         TMatch[]   @relation("p2")

  @@unique([tournamentId, userId])
}

model TMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  tableNo      Int
  p1Id         String
  p2Id         String? // null = BYE (p1 vence automaticamente)
  p1Report     String? // WIN | LOSS
  p2Report     String? // WIN | LOSS
  winnerId     String? // TournamentPlayer.id
  status       String    @default("PENDING") // PENDING | CONFLICT | DONE
  resolvedBy   String? // AUTO | ORGANIZER | ROUNDS
  p1Score      Int       @default(0) // rounds vencidos (MD3) / 1-0 no modo único
  p2Score      Int       @default(0)
  tableToken   String? // link da tela de mesa (dispositivo do organizador na mesa)
  updatedAt    DateTime  @updatedAt
  rounds       MatchRound[]
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  p1           TournamentPlayer  @relation("p1", fields: [p1Id], references: [id], onDelete: Cascade)
  p2           TournamentPlayer? @relation("p2", fields: [p2Id], references: [id], onDelete: Cascade)

  @@index([tournamentId, round])
}

/// Round de uma partida (histórico completo, inclusive no modo único): quem reportou,
/// quem confirmou, se foi contestado ou anulado — auditoria do resultado.
model MatchRound {
  id          String    @id @default(cuid())
  matchId     String
  no          Int
  winnerId    String? // TournamentPlayer.id
  claimedBy   String // P1 | P2 | ORGANIZER
  status      String    @default("PENDING") // PENDING | CONFIRMED | DISPUTED | VOID
  resolvedBy  String? // OPPONENT | AUTO | ORGANIZER
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  match       TMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

// ---------------------------------------------------------------------------
// Moderação, cosméticos e operação
// ---------------------------------------------------------------------------

model Report {
  id          String    @id @default(cuid())
  reporterId  String?
  targetType  String // DECK | USER | LISTING | COMBO | TOURNAMENT
  targetId    String
  reason      String
  category    String? // INAPPROPRIATE | SPAM | SCAM | HARASSMENT | OTHER
  status      String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolution  String?
  handledById String?
  createdAt   DateTime  @default(now())
  handledAt   DateTime?

  @@index([status])
}

model Cosmetic {
  id        String   @id @default(cuid())
  kind      String // FRAME | STICKER
  name      String
  imageUrl  String? // FRAMEs podem ser CSS puro (styleKey) em vez de imagem
  styleKey  String? // chave de moldura pré-definida em CSS (ex.: "xtreme", "ember")
  active    Boolean  @default(true)
  isDefault Boolean  @default(false) // true = disponível para todos
  createdAt DateTime @default(now())

  grants    CosmeticGrant[]
}

model CosmeticGrant {
  id          String   @id @default(cuid())
  userId      String
  cosmeticId  String
  grantedById String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  href      String?
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Setting {
  key   String @id
  value String // JSON
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String
  ok        Boolean
  message   String?
  createdAt DateTime @default(now())
}

/// Deck físico (Sessão física): peças reais reservadas pelo usuário. Vive na conta.
model PhysicalDeck {
  id        String   @id @default(cuid())
  userId    String
  name      String
  deckJson  String // {slots:[{mode,blade,lock,main,assist,over,ratchet,bit,rib}] com ids de Part, beys:[[partId]], names:[]}
  position  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comunidade (feed estilo Reddit + YouTube)
// ---------------------------------------------------------------------------

model Post {
  id            String    @id @default(cuid())
  authorId      String
  tag           String // CLIP | UNBOXING | CHANNEL | SALE | RESULT | CHAMPION | HELP | OFFTOPIC
  title         String
  body          String?
  mediaJson     String    @default("[]") // [{type:image|gif|video|embed, url, poster?}]
  pollJson      String? // {options:[{id,text}], endsAt}
  saleJson      String? // {priceCents, condition, contact}
  status        String    @default("VISIBLE") // VISIBLE | PENDING (triagem automática) | HIDDEN | REMOVED
  flagJson      String? // resultado da triagem automática de imagem
  reactionCount Int       @default(0)
  commentCount  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  votes         PollVote[]

  @@index([status, createdAt])
  @@index([tag, status])
  @@index([authorId])
}

model Comment {
  id            String    @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  body          String
  status        String    @default("VISIBLE") // VISIBLE | HIDDEN | REMOVED
  reactionCount Int       @default(0)
  createdAt     DateTime  @default(now())
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  targetType String // POST | COMMENT
  targetId   String
  kind       String // FIRE | TOP | LOL | WOW
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model PollVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  optionId  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String // quem recebe
  type      String // REACTION | COMMENT | REPLY | MENTION | POST_APPROVED | POST_HIDDEN | REPORT_RESOLVED
  actorId   String?
  postId    String?
  commentId String?
  text      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("notifTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
